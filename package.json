{
  "name": "painel-disparos",
  "version": "1.0.0",
  "description": "Dashboard de disparos, respostas e taxa de resposta dos bots de Welcome do cliente",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "ingest": "node dist/ingest.js",
    "dev": "tsx src/server.ts",
    "dev:ingest": "tsx src/ingest.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "build:pages": "esbuild src/browser-demo.ts --bundle --format=iife --target=es2020 --minify --outfile=docs/demo-api.js && node tools/build-pages.mjs",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

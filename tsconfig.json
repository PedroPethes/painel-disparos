{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // browser-demo.ts é do navegador (DOM, sem Node) e é compilado só pelo
  // esbuild em `npm run build:pages` — ver tsconfig.browser.json.
  "exclude": ["node_modules", "dist", "src/browser-demo.ts"]
}
